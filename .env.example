# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SUPERUSER_EMAIL=your-pocketbase-admin-email
POCKETBASE_SUPERUSER_PASSWORD=your-pocketbase-admin-password
